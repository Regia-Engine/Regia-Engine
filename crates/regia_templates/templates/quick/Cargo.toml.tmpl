[package]
name = "{{crate_name}}"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
regia = { path = "{{engine}}/crates/regia" }

# The Windows exe icon and version info (build.rs, ADR-2645).
[build-dependencies]
winresource = "0.1.34"
png = "0.18"
toml = { version = "1", default-features = false, features = ["std", "parse"] }

# Opt the engine's dependencies into optimisation so debug builds of the game run smoothly.
[profile.dev.package."*"]
opt-level = 2

# `regia package --profile shipping` builds with this profile (specs/21 § 4): fat LTO, one codegen
# unit, abort on panic, line tables kept and nothing stripped by cargo. `regia package` extracts the
# symbols into `dist/<platform>/symbols/` and strips the shipped copy itself.
[profile.shipping]
inherits = "release"
lto = "fat"
codegen-units = 1
panic = "abort"
debug = "line-tables-only"
strip = "none"
