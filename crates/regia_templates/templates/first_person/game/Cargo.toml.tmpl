[package]
name = "{{crate_name}}"
version.workspace = true
edition.workspace = true
publish.workspace = true

[features]
# The editor builds this crate with `--features hot-reload` (specs/20 § 1): it links the shared
# engine dylib and activates `regia_editor` so this rebuild resolves the same features as the
# editor (the feature anchor). The source never names either crate.
hot-reload = ["dep:regia_dylib", "dep:regia_editor", "regia_editor/hot-dylib"]

[dependencies]
regia = { path = "{{engine}}/crates/regia" }
regia_core = { path = "{{engine}}/crates/regia_core" }
regia_framework = { path = "{{engine}}/crates/regia_framework" }
regia_input = { path = "{{engine}}/crates/regia_input" }
regia_render = { path = "{{engine}}/crates/regia_render" }
regia_scene = { path = "{{engine}}/crates/regia_scene" }
tracing = "0.1"
regia_dylib = { path = "{{engine}}/crates/regia_dylib", optional = true }
# Feature anchor only. Not referenced from Rust (specs/20 § 1).
regia_editor = { path = "{{engine}}/crates/regia_editor", optional = true }

[dev-dependencies]
# The agent-protocol smoke tests (`tests/agent_smoke.rs`) talk JSON to the in-process agent.
serde_json = "1"
