// `.audiopatch.ron` fixture (format version 2): the rover example from
// docs/formats/audio-patch-v2.md. One layer of each v2 kind next to a v1-style loop: a granular
// gravel layer scrubbed by `speed`, a one-shot gear clunk on every whole `gear`, a manual horn,
// and `speed` bound to the reflected `Rover.speed` field.
(
    version: 2,
    name: "rover",
    bus: Some("Sfx"),
    parameters: [
        (
            name: "speed",
            min: 0.0,
            max: 30.0,
            smoothing_secs: 0.1,
            binding: Some((component: "Rover", field: "speed", scale: 1.0, offset: 0.0)),
        ),
        (
            name: "gear",
            min: 0.0,
            max: 5.0,
            smoothing_secs: 0.02,
        ),
    ],
    layers: [
        (
            name: "motor",
            sound: Some("audio/rover/motor.ogg"),
            volume_db: -9.0,
            pitch_curves: [(parameter: "speed", points: [(0.0, 0.8), (30.0, 1.6)])],
        ),
        (
            name: "gravel",
            volume_db: -12.0,
            volume_curves: [(parameter: "speed", points: [(0.0, -40.0), (5.0, 0.0)])],
            filter_curves: [(parameter: "speed", points: [(0.0, 900.0), (30.0, 9000.0)])],
            granular: Some((
                sound: "audio/rover/gravel.ogg",
                grain_secs: 0.04,
                density_hz: 50.0,
                position: 0.1,
                position_curves: [(parameter: "speed", points: [(0.0, 0.0), (30.0, 0.8)])],
                density_curves: [(parameter: "speed", points: [(0.0, 0.5), (30.0, 2.0)])],
                position_jitter: 0.05,
                seed: 27,
            )),
        ),
        (
            name: "shift",
            volume_db: -6.0,
            one_shot: Some((
                sounds: ["audio/rover/clunk_a.ogg", "audio/rover/clunk_b.ogg"],
                trigger: Every(parameter: "gear", step: 1.0),
                cooldown_secs: 0.15,
            )),
        ),
        (
            name: "horn",
            one_shot: Some((
                sounds: ["audio/rover/horn.ogg"],
                trigger: Manual,
            )),
        ),
    ],
)
