# mesh: full update, one triangle
# Laid out by hand from docs/formats/dcc-feed-protocol-v1.md (spec 60 section 8 test 1).
62 00 00 00                                          # len = 98
23 00                                                # msg_type 0x0023
00 00                                                # flags
01 00 00 00                                          # seq 1
02 00 00 00                                          # handle 2
03 00 00 00 00 00 00 00                              # frame_id 3
1e 00 00 00 00 00 00 00                              # source_time_ns 30
00                                                   # has_timecode 0
00                                                   # update_mode 0 full
02 00                                                # section_count 2
01                                                   # section 1 positions
00                                                   # elem f32
00 00                                                # index 0
03 00 00 00                                          # count 3
24 00 00 00                                          # byte_len 36
00 00 00 00 00 00 00 00 00 00 00 00 00 00 80 3f 00 00 00 00 00 00 00 00 00 00 00 00 00 00 80 3f 00 00 00 00 # three vertices
06                                                   # section 6 indices
02                                                   # elem u16
00 00                                                # index 0
03 00 00 00                                          # count 3
06 00 00 00                                          # byte_len 6
00 00 01 00 02 00                                    # 0 1 2
