# light: world-space spot values
# Laid out by hand from docs/formats/dcc-feed-protocol-v1.md (spec 60 section 8 test 1).
62 00 00 00                                          # len = 98
22 00                                                # msg_type 0x0022
00 00                                                # flags
01 00 00 00                                          # seq 1
05 00 00 00                                          # handle 5
02 00 00 00 00 00 00 00                              # frame_id 2
14 00 00 00 00 00 00 00                              # source_time_ns 20
00                                                   # has_timecode 0
00 00 80 3f 00 00 00 40 00 00 40 40                  # translation (1, 2, 3)
00 00 00 00 00 00 00 00 00 00 00 00 00 00 80 3f      # rotation (0, 0, 0, 1)
00 00 80 3f 00 00 80 3f 00 00 80 3f                  # scale (1, 1, 1)
01                                                   # space_flags 1
00 00 80 3f 00 00 00 3f 00 00 80 3e                  # color
00 00 48 44                                          # intensity
00 00 20 41                                          # range
00 00 80 3e 00 00 00 3f                              # spot_inner_rad spot_outer_rad
