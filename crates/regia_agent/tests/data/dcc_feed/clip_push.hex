# clip_push: one linear translation track
# Laid out by hand from docs/formats/dcc-feed-protocol-v1.md (spec 60 section 8 test 1).
4b 00 00 00                                          # len = 75
26 00                                                # msg_type 0x0026
00 00                                                # flags
01 00 00 00                                          # seq 1
04 00 77 61 76 65                                    # name "wave"
00 00 f0 41                                          # fps
00 00 80 3f                                          # duration_s
01                                                   # loop
00 00 00 00                                          # bind_handle 0
01 00 00 00                                          # track_count 1
04 00 63 75 62 65                                    # target "cube"
00                                                   # property 0 translation
01                                                   # interp 1 linear
02 00 00 00                                          # key_count 2
00 00 00 00 00 00 80 3f                              # times
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 80 3f 00 00 00 00 # values
