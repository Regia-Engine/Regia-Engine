# ping
# Laid out by hand from docs/formats/dcc-feed-protocol-v1.md (spec 60 section 8 test 1).
18 00 00 00                                          # len = 24
30 00                                                # msg_type 0x0030
00 00                                                # flags
01 00 00 00                                          # seq 1
2a 00 00 00 00 00 00 00                              # token 42
e8 03 00 00 00 00 00 00                              # sender_time_ns 1000
