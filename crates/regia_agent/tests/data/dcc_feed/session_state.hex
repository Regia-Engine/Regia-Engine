# session_state
# Laid out by hand from docs/formats/dcc-feed-protocol-v1.md (spec 60 section 8 test 1).
13 00 00 00                                          # len = 19
83 00                                                # msg_type 0x0083
00 00                                                # flags
01 00 00 00                                          # seq 1
02                                                   # state 2 active
08 00 61 63 63 65 70 74 65 64                        # reason "accepted"
