// A render job (`.render_job.ron` v2, ADR-1616, ADR-1880): three takes of a trailer's shot list, one
// folder per take under renders/trailer/<date>/, the shot boundaries plus one explicit cut, a pre-roll
// cap, and a binding table so the job plays the trailer's sequence on its own player.
(
    version: 2,
    name: "trailer",
    shots: Some("cinematics/trailer.shots.ron"),
    sequence: Some("cinematics/trailer.seq.ron"),
    bindings: {
        "hero": Name("Hero"),
        "lamp": Guid("00000000-0000-0000-0000-00000000002a"),
    },
    out: "renders/trailer",
    path: "{date}/{take}/{job}_{take}",
    output: (
        width: Some(1920),
        height: Some(1080),
        fps: Some(24),
        supersample: Some(2),
        format: Some("png"),
        hud: Some(false),
        warmup_frames: Some(16),
        settle_frames: Some(16),
        subframes: Some(4),
        shutter_angle: Some(180.0),
        audio: Some((stems: ["music"])),
    ),
    takes: [
        (name: "opening", range: Shots(first: "wide", last: "close")),
        (name: "blast", range: Markers(from: "boom", to: "dust_settled")),
        (name: "tail", range: Seconds(start: 42.0, end: 48.5), path: Some("{take}/tail_{frame}")),
    ],
    cuts: [Marker("flash"), Seconds(30.0)],
    max_preroll_frames: Some(2400),
)
