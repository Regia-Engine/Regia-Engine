(
    format_version: 4,
    name: "hull_panel",
    params: [
        (
            name: "tint",
            value: Color((0.07, 0.16, 0.52)),
        ),
        (
            name: "roughness",
            value: Float(0.42),
        ),
        (
            name: "metallic",
            value: Float(0.0),
        ),
        (
            name: "parallax_scale",
            value: Float(0.08),
        ),
        (
            name: "wear_tint",
            value: Color((0.8, 0.81, 0.84)),
        ),
        (
            name: "wear_bias",
            value: Float(0.55),
        ),
        (
            name: "wear_contrast",
            value: Float(5.0),
        ),
        (
            name: "wear_intensity",
            value: Float(0.9),
        ),
        (
            name: "wear_roughness",
            value: Float(-0.22),
        ),
        (
            name: "wear_metallic",
            value: Float(0.85),
        ),
        (
            name: "detail_scale",
            value: Vec2((8.0, 8.0)),
        ),
        (
            name: "detail_albedo",
            value: Float(0.28),
        ),
        (
            name: "detail_normal",
            value: Float(0.22),
        ),
        (
            name: "detail_fade_end",
            value: Float(24.0),
        ),
        (
            name: "detail_fade_range",
            value: Float(18.0),
        ),
    ],
    textures: [
        (
            name: "paint",
            path: "textures/hull_paint.png",
            color_space: Srgb,
        ),
        (
            name: "grain",
            path: "textures/hull_grain.png",
            color_space: Linear,
        ),
        (
            name: "flake",
            path: "textures/hull_flake.png",
            color_space: Linear,
        ),
        (
            name: "relief",
            path: "textures/hull_relief.png",
            color_space: Linear,
        ),
    ],
    switches: [],
    functions: {},
    nodes: {
        "alpha": Mul("paint_a", "vcol_a"),
        "base": Mul("worn", "grain_scale"),
        "curvature": Swizzle(
            input: "relief_sample",
            channels: "g",
        ),
        "detail_albedo": Param("detail_albedo"),
        "detail_mask": Swizzle(
            input: "flake_sample",
            channels: "a",
        ),
        "detail_normal": Param("detail_normal"),
        "detail_scale": Param("detail_scale"),
        "detail_uv": Mul("uv", "detail_scale"),
        "distance": CameraDistance,
        "fade": Saturate("fade_ratio"),
        "fade_end": Param("detail_fade_end"),
        "fade_left": Sub("fade_end", "distance"),
        "fade_mask": Mul("fade", "detail_mask"),
        "fade_range": Param("detail_fade_range"),
        "fade_ratio": Div("fade_left", "fade_range"),
        "flake_sample": Sample(
            texture: "flake",
            uv: "detail_uv",
            lod: Some("zero"),
        ),
        "flake_scaled": NormalStrength(
            normal: "flake_unpacked",
            strength: "normal_weight",
        ),
        "flake_unpacked": UnpackNormal("flake_sample"),
        "flat_normal": Vec3((0.0, 0.0, 1.0)),
        "grain_doubled": Mul("grain_rgb", "two"),
        "grain_rgb": Swizzle(
            input: "grain_sample",
            channels: "rgb",
        ),
        "grain_sample": Sample(
            texture: "grain",
            uv: "detail_uv",
            lod: Some("zero"),
        ),
        "grain_scale": Lerp(
            a: "one3",
            b: "grain_doubled",
            t: "grain_weight",
        ),
        "grain_weight": Mul("fade_mask", "detail_albedo"),
        "metallic": Saturate("metallic_sum"),
        "metallic_base": Saturate("metallic_param"),
        "metallic_param": Param("metallic"),
        "metallic_sum": Add("metallic_base", "metallic_wear"),
        "metallic_wear": Mul("wear_metallic", "wear"),
        "normal": BlendNormals(
            base: "flat_normal",
            detail: "flake_scaled",
            mode: Whiteout,
        ),
        "normal_weight": Mul("fade_mask", "detail_normal"),
        "one3": Vec3((1.0, 1.0, 1.0)),
        "paint": Sample(
            texture: "paint",
            uv: "uv",
            lod: None,
        ),
        "paint_a": Swizzle(
            input: "paint",
            channels: "a",
        ),
        "paint_rgb": Swizzle(
            input: "paint",
            channels: "rgb",
        ),
        "painted": Mul("tinted", "vcol_rgb"),
        "parallax_scale": Param("parallax_scale"),
        "relief_sample": Sample(
            texture: "relief",
            uv: "uv",
            lod: Some("zero"),
        ),
        "roughness": Saturate("roughness_sum"),
        "roughness_base": Saturate("roughness_param"),
        "roughness_param": Param("roughness"),
        "roughness_sum": Add("roughness_base", "roughness_wear"),
        "roughness_wear": Mul("wear_roughness", "wear"),
        "tint": Param("tint"),
        "tinted": Mul("paint_rgb", "tint"),
        "two": Float(2.0),
        "uv": Parallax(
            texture: "relief",
            channel: R,
            uv: "uv0",
            scale: "parallax_scale",
            min_steps: 4.0,
            max_steps: 16.0,
        ),
        "uv0": TexCoord,
        "vcol": VertexColor,
        "vcol_a": Swizzle(
            input: "vcol",
            channels: "a",
        ),
        "vcol_rgb": Swizzle(
            input: "vcol",
            channels: "rgb",
        ),
        "wear": Mul("wear_mask", "wear_intensity"),
        "wear_bias": Param("wear_bias"),
        "wear_contrast": Param("wear_contrast"),
        "wear_intensity": Param("wear_intensity"),
        "wear_mask": Saturate("wear_scaled"),
        "wear_metallic": Param("wear_metallic"),
        "wear_offset": Sub("curvature", "wear_bias"),
        "wear_roughness": Param("wear_roughness"),
        "wear_scaled": Mul("wear_offset", "wear_contrast"),
        "wear_tint": Param("wear_tint"),
        "worn": Lerp(
            a: "painted",
            b: "wear_tint",
            t: "wear",
        ),
        "zero": Float(0.0),
    },
    output: (
        base_color: Some("base"),
        alpha: Some("alpha"),
        metallic: Some("metallic"),
        roughness: Some("roughness"),
        normal: Some("normal"),
        normal_space: Tangent,
        occlusion: None,
        emissive: None,
        world_position_offset: None,
    ),
    shading: (
        alpha_mode: Opaque,
        unlit: false,
        clearcoat: 1.0,
        clearcoat_roughness: 0.04,
        anisotropy: 0.0,
        anisotropy_rotation: 0.0,
        specular_occlusion: true,
        multi_scatter: true,
        max_vertex_offset: 0.0,
    ),
)