(
    format_version: 1,
    class_name: "vehicle",
    scale: (meters_per_unit: 1.0, identity_tolerance: 0.001),
    axes: (up: pos_y, forward: pos_z),
    origin: (
        ground_offset_m: 0.0,
        ground_tolerance_m: 0.05,
        coarse_floor_rise_m: 0.25,
        center_fraction: 0.1,
    ),
    lod: (
        required: ["lod0"],
        optional: [],
        budget_lod: "lod0",
        lod0_min_triangles: 1,
        lod0_max_triangles: 100000,
        chain: ["lod0"],
        ratios: [],
        hard_caps: [],
        require_decreasing: true,
    ),
    max_joint_influences: 8,
    required_nodes: [(pattern: "root", count: 1)],
    required_sockets: [(pattern: "socket_hatch*", count: 2)],
    required_clips: [(pattern: "hatch_open", count: 1)],
    max_materials: 6,
    material_warn_above: 5,
    texture_max_edge: 4096,
    footprint: Some((radius_m: 2.5, tolerance: 0.15)),
    socket_clearance: [(pattern: "socket_hatch*", min_width_m: 0.6, min_height_m: 0.9)],
)
