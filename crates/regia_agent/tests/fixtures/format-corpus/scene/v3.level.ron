// Example `.level.ron` (format version 3, `docs/formats/scene-files.md`).
//!
//! A small courtyard: one ground plane, a door assembly built from entities, and a lamp
//! instantiated from a prefab with an intensity override and an added component. Entities
//! reference the lamp prefab by asset guid; overrides reference the lamp's *local ids*.
//!
//! Run `cargo test -p ferrite_scene --test formats` to parse this file against the schema rules.

SceneFile(
    format_version: 3,
    entities: [
        (
            guid: "3f7a1c2e-8b64-4a35-9d20-6f1e2b3c4d5a",
            name: "Courtyard",
            components: {
                "ferrite_scene::transform::Transform": (
                    translation: (0.0, 0.0, 0.0),
                    rotation: (0.0, 0.0, 0.0, 1.0),
                    scale: (1.0, 1.0, 1.0),
                ),
            },
        ),
        (
            guid: "9b2e6f0a-1e42-4c11-8d5a-3c2f7e10d0aa",
            name: "Ground",
            parent: Some("3f7a1c2e-8b64-4a35-9d20-6f1e2b3c4d5a"),
            components: {
                "ferrite_scene::transform::Transform": (
                    translation: (0.0, 0.0, 0.0),
                    rotation: (0.0, 0.0, 0.0, 1.0),
                    scale: (20.0, 1.0, 20.0),
                ),
                "ferrite_scene::components::Static": (),
                "ferrite_scene::components::Tags": (["ground", "walkable"]),
            },
        ),
        (
            guid: "c7d4e2f8-93b1-4a67-8e0c-5d6f7a8b9c0d",
            name: "North Wall",
            parent: Some("3f7a1c2e-8b64-4a35-9d20-6f1e2b3c4d5a"),
            components: {
                "ferrite_scene::transform::Transform": (
                    translation: (0.0, 2.0, -5.0),
                    rotation: (0.0, 0.0, 0.0, 1.0),
                    scale: (10.0, 4.0, 0.5),
                ),
                "ferrite_scene::components::Static": (),
            },
        ),
        (
            guid: "2ab08f1c-6f2a-4b77-9a3e-2c51b0d4e7aa",
            name: "Door Assembly",
            parent: Some("3f7a1c2e-8b64-4a35-9d20-6f1e2b3c4d5a"),
            components: {
                "ferrite_scene::transform::Transform": (
                    translation: (0.0, 0.0, -4.7),
                    rotation: (0.0, 0.0, 0.0, 1.0),
                    scale: (1.0, 1.0, 1.0),
                ),
            },
        ),
        (
            guid: "8f1c9e60-6f2a-4b77-9a3e-2c51b0d4e7aa",
            name: "Door",
            parent: Some("2ab08f1c-6f2a-4b77-9a3e-2c51b0d4e7aa"),
            components: {
                "ferrite_scene::transform::Transform": (
                    translation: (0.0, 1.0, 0.0),
                    rotation: (0.0, 0.0, 0.0, 1.0),
                    scale: (1.0, 1.0, 1.0),
                ),
                "my_game::Door": (open_angle: 1.57),
            },
        ),
        (
            guid: "d1e2f3a4-b5c6-4d7e-8f90-1a2b3c4d5e6f",
            name: "Yard Lamp",
            parent: Some("3f7a1c2e-8b64-4a35-9d20-6f1e2b3c4d5a"),
            prefab_instance: (
                prefab: "asset:44fe6f0a-1e42-4c11-8d5a-9b3c2f7e10d0",
                overrides: [
                    (
                        target: "0f1e8a44-90d3-4f2e-b7c5-6a2d0e4f8b11",
                        component: "ferrite_render::PointLight",
                        path: ".intensity",
                        value: 800.0,
                    ),
                ],
                added_components: [
                    (
                        target: "0f1e8a44-90d3-4f2e-b7c5-6a2d0e4f8b11",
                        component: "ferrite_scene::components::Tags",
                        value: (["courtyard", "evening"]),
                    ),
                ],
                removed_components: [],
                added_children: [],
                removed_children: [],
            ),
        ),
    ],
    resources: {
        "ferrite_scene::level::LevelSettings": (
            gravity: (0.0, -9.81, 0.0),
            environment: Some("asset:7e3d9c1a-4b25-4f88-a6d1-0c9e8f7b6a55"),
            game_rules: Some("my_game::rules::CourtyardRules"),
            ambient_audio: Some("asset:5b6c7d8e-9f0a-4b1c-8d2e-3f4a5b6c7d8e"),
            streaming_enabled: false,
            atmosphere: (
                preset: Earth,
                time_of_day: Some((hour: 16.5, day_of_year: 172, latitude_deg: 40.0)),
                sun_illuminance_lux: None,
                cloud_coverage: 0.3,
