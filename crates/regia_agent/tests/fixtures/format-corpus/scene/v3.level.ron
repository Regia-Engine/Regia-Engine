                sky_body: None,
                moons: [],
                haze: (density: 0.0, scale_height_m: 200.0, base_height_m: 0.0),
            ),
            look: (
                exposure_bias_ev: 0.0,
                min_ev100: None,
                max_ev100: None,
                meter: None,
                contrast: None,
                saturation: None,
                grade: None,
            ),
        ),
    },
)
