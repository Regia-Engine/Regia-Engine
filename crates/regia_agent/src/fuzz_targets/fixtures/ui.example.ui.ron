(
    version: 1,
    root: (
        name: "hud",
        safe_area: true,
        style: (direction: column, padding: 16, gap: (8, 8)),
        children: [
            (
                name: "score",
                classes: ["surface"],
                style: (padding: 8, size: (200, Auto)),
                text: (spans: ["Score: 0"], style: (font_px: 22)),
                bind: (source: "Score.value", format: "Score: {:03}"),
            ),
            (
                widget: button,
                interactable: true,
                style: (padding: 10),
                children: [(
                    text: (spans: [Loc("menu-start")]),
                )],
            ),
        ],
    ),
)
