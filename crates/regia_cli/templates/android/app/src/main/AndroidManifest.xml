<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by `regia package`. Regenerated on every build; do not edit. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
{{permissions}}
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:appCategory="game"
        android:isGame="true"
        android:hasCode="true"
        android:allowBackup="false"
        android:theme="@style/Theme.Regia"
        tools:targetApi="29">

        <!-- singleTask + configChanges: the activity must never be recreated, because recreation
             would run android_main a second time and the event loop can only be created once. -->
        <activity
            android:name=".RegiaActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize|fontScale|locale|layoutDirection|colorMode"
            android:screenOrientation="{{orientation}}">

            <!-- GameActivity loads lib<value>.so and calls its android_main. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="{{lib_name}}" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
