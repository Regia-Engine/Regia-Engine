<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by `regia package`. Regenerated on every build; do not edit.
     The debug source set: AGP merges this into debug APKs only, never into shipping builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The agent server (specs/23) listens on 127.0.0.1 and is reached through `adb forward`;
         Android refuses every socket, loopback included, without INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application>
        <!-- A locked test phone still shows (and renders) the game, so agent and CI runs on a
             device need nobody to unlock it. -->
        <activity
            android:name=".RegiaActivity"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            tools:node="merge" />
    </application>
</manifest>
