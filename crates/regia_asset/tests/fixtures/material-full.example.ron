(
    format_version: 3,
    name: "FuzzEveryBlock",
    shader: Standard,
    base: (
        base_color: (0.42, 0.45, 0.48, 1.0),
        metallic: 0.25,
        roughness: 0.55,
        normal_map: "textures/full_normal.png",
        orm_map: "textures/full_orm.png",
        base_color_map: "textures/full_albedo.png",
        emissive: (0.1, 0.2, 0.3),
        emissive_map: "textures/full_emissive.png",
        emissive_strength: 2.5,
        orm_packed: true,
        ior: 1.45,
    ),
    clearcoat: (factor: 0.4, roughness: 0.06, normal_map: "textures/full_coat_normal.png"),
    anisotropy: (strength: 0.5, direction: (0.0, 1.0)),
    layers: [
        (
            name: "dust",
            mask: "textures/dust_mask.png",
            base_color: (0.7, 0.68, 0.6, 1.0),
            roughness: 0.95,
            metallic: 0.0,
            triplanar: false,
            normal_map: "textures/dust_normal.png",
        ),
        (
            name: "wetness",
            mask: "textures/wet_mask.png",
            base_color: (0.2, 0.22, 0.25, 0.6),
            roughness: 0.15,
            metallic: 0.0,
            triplanar: true,
        ),
        (
            name: "rust",
            mask: "textures/rust_mask.png",
            base_color: (0.5, 0.2, 0.1, 1.0),
            roughness: 0.8,
            metallic: 0.3,
            triplanar: false,
        ),
        (
            name: "soot",
            mask: "textures/soot_mask.png",
            base_color: (0.05, 0.05, 0.05, 1.0),
            roughness: 0.9,
            metallic: 0.0,
            triplanar: true,
        ),
    ],
    render_state: (
        alpha_mode: mask,
        cull_mode: none,
        depth_write: false,
        queue_offset: -2,
        alpha_cutoff: 0.33,
    ),
    hard_surface: (
        detail: (
            albedo: "textures/full_detail_albedo.png",
            normal: "textures/full_detail_normal.png",
            roughness: "textures/full_detail_roughness.png",
            mask: "textures/full_detail_mask.png",
            uv_scale: (4.0, 8.0),
            albedo_strength: 1.0,
            normal_strength: 0.75,
            roughness_strength: 0.6,
            fade_start: 2.0,
            fade_end: 18.0,
        ),
        parallax: (
            height_map: "textures/full_height.png",
            scale: 0.04,
            min_steps: 4,
            max_steps: 12,
        ),
        edge_wear: (
            source: ao,
            curvature_map: "textures/full_curvature.png",
            intensity: 0.85,
            roughness_bias: -0.15,
            metallic_bias: 0.7,
            tint: (0.75, 0.76, 0.78),
            bias: 0.5,
            contrast: 4.0,
        ),
        multi_scatter: false,
        specular_occlusion: true,
    ),
    transmission: (
        factor: 0.5,
        thickness: 0.012,
        attenuation_color: (0.75, 0.88, 0.84),
        attenuation_distance: 0.08,
    ),
)
