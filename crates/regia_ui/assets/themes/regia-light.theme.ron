// regia-light: light scheme (docs/specs/ui-default-design.md section 2). Child of regia-dark:
// it replaces the colors and shadow strength and inherits spacing, type, sizes and motion.
// `color.accent-hover`, `color.accent-pressed` and `color.info` are inherited expressions.
(
    format_version: 2,
    name: "regia-light",
    extends: Some("regia-dark"),
    scheme: light,
    tokens: {
        // Color roles
        "color.bg": "#e9edf2",
        "color.surface": "#f6f8fa",
        "color.surface-raised": "#ffffff",
        "color.surface-overlay": "#ffffff",
        "color.surface-sunken": "#e3e8ee",
        "color.border": "#c9d1db",
        "color.border-strong": "#7c8796",
        "color.text": "#18202a",
        "color.text-muted": "#566170",
        "color.text-disabled": "#8f99a5",
        "color.accent": "#1d6fc4",
        "color.on-accent": "#ffffff",
        "color.selection": "alpha(@color.accent, 0.2)",
        "color.focus-ring": "#0b4f9e",
        "color.danger": "#c4372f",
        "color.on-danger": "#ffffff",
        "color.warning": "#975a00",
        "color.success": "#1f7a35",
        "color.scrim": "#0f131866",
        "color.shadow": "#0f1318",

        // Elevation alpha (shadows are lighter on light surfaces)
        "elevation.1.alpha": 0.1,
        "elevation.2.alpha": 0.14,
        "elevation.3.alpha": 0.2,
    },
)
