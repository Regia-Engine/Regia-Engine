                    footprint: (core_m: Some(0.05), spread_m: Some(0.25)),
                    placement: (upright: 0.4, scale: Range(0.6, 1.2), yaw: Random),
                    render: (cast_shadows: false, draw_distance_m: 150.0, fade_m: 20.0, collision: None),
