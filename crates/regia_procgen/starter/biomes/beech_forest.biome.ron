                    placement: (upright: 1.0, scale: Range(0.7, 1.25), yaw: Random, sink_m: 0.2),
                    render: (cast_shadows: true, draw_distance_m: 1200.0, fade_m: 80.0, collision: Simple),
                ),
            ],
            max_child_depth: 0,
        ),
        (
            name: "field",
            rank: 0,
            sharing: Shared,
            source: Ground(spacing_m: 1.4, jitter: 1.0, noise: Some((scale_m: 25.0, octaves: 2, min: 0.2, max: 1.0))),
            entries: [
