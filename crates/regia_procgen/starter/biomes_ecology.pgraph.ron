ProcGraph(
    format_version: 1,
    description: "Biomes with ecology (ADR-2456): the starter biomes graph plus biome.ecology, which applies each biome's competition rules (shade-needing understory only under crowns, light-demanding understory out of deep shade, canopy self-thinning)",
    nodes: {
        1: (ty: "in.self", settings: {}, at: (0.0, 0.0)),
        2: (ty: "biome.areas", settings: {}, at: (220.0, 0.0)),
        3: (ty: "in.ground", settings: {}, at: (220.0, 160.0)),
        4: (ty: "biome.layer", settings: {}, at: (440.0, 0.0)),
        5: (ty: "biome.resolve", settings: {}, at: (660.0, 0.0)),
        9: (ty: "biome.ecology", settings: {}, at: (770.0, 120.0)),
        6: (ty: "biome.exclude", settings: {}, at: (880.0, 0.0)),
        7: (ty: "biome.spawn", settings: {}, at: (1100.0, 0.0)),
        8: (ty: "biome.grass_mask", settings: {}, at: (440.0, 240.0)),
    },
    edges: [
        (from: (1, "out"), to: (2, "bounds")),
        (from: (2, "out"), to: (4, "claims")),
        (from: (3, "out"), to: (4, "ground")),
        (from: (4, "out"), to: (5, "in")),
        (from: (5, "out"), to: (9, "in")),
        (from: (9, "out"), to: (6, "in")),
        (from: (6, "out"), to: (7, "in")),
        (from: (2, "out"), to: (8, "claims")),
    ],
    flags: (starter: true),
)
