// `.vfx.ron` fuzz seed (format version 7, ADR-2800): every v7 addition once: a mesh-surface
// shape with the Normal velocity, a skinned-mesh shape, both kill volumes and a ribbon.
(
    version: 7,
    name: "shapes_ribbons",
    system: (budget: 512),
    emitters: [
        (
            name: "surface",
            spawn: (mode: Rate(60.0), lifetime: (min: 0.5, max: 1.0)),
            init: (
                shape: MeshSurface(mesh: "meshes/rock.mesh"),
                velocity: (mode: Normal(speed: (min: 1.0, max: 2.0))),
                size: (min: 0.05, max: 0.1),
            ),
            update: (
                gravity: (0.0, -9.8, 0.0),
                kill_volume: Some((shape: Box(half_extents: (2.0, 1.0, 2.0)), center: (0.0, 1.0, 0.0), kill: Outside)),
            ),
            render: (mode: Stretched, sprite: Spark),
        ),
        (
            name: "skin",
            spawn: (mode: Burst(32), lifetime: (min: 0.3, max: 0.6)),
            init: (shape: SkinnedMesh(mesh: "meshes/hero.mesh", max_per_frame: 16), size: (min: 0.1, max: 0.1)),
            update: (kill_volume: Some((shape: Sphere(radius: 0.5), center: (0.0, -1.0, 0.0)))),
            render: (mode: Billboard),
        ),
        (
            name: "ribbon",
            spawn: (mode: Rate(30.0), lifetime: (min: 1.0, max: 1.0)),
            init: (size: (min: 0.2, max: 0.2)),
            render: (
                mode: Ribbon,
                blend: Alpha,
                ribbon: (
                    link: SpawnGroup,
                    max_points: 32,
                    width: [(t: 0.0, v: 1.0), (t: 1.0, v: 0.0)],
                    color: [(t: 0.0, color: "#ffffff"), (t: 1.0, color: "#ff000000")],
                    texture: Tile(0.5),
                ),
            ),
        ),
    ],
)
