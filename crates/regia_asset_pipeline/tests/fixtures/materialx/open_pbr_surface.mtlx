<?xml version="1.0"?>
<!-- Hand-written fixture (ADR-3341): an OpenPBR Surface with constant inputs, emission in nits,
     a coat, partial opacity and a fuzz lobe the lit model does not have. -->
<materialx version="1.39">
  <open_pbr_surface name="SR_gold" type="surfaceshader">
    <input name="base_color" type="color3" value="1.0, 0.78, 0.34" />
    <input name="base_metalness" type="float" value="1.0" />
    <input name="specular_roughness" type="float" value="0.25" />
    <input name="coat_weight" type="float" value="0.5" />
    <input name="coat_roughness" type="float" value="0.1" />
    <input name="fuzz_weight" type="float" value="0.2" />
    <input name="fuzz_color" type="color3" value="0.9, 0.9, 1.0" />
    <input name="thin_film_weight" type="float" value="1.0" />
    <input name="emission_luminance" type="float" value="12.0" />
    <input name="emission_color" type="color3" value="1.0, 0.5, 0.2" />
    <input name="geometry_opacity" type="float" value="0.8" />
  </open_pbr_surface>
  <surfacematerial name="M_gold" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_gold" />
  </surfacematerial>
</materialx>
