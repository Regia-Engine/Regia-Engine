// Android reference budgets (`docs/06-testing-and-ci.md` § 3 "Android reference", § 4 column
// "Android ref"). `cargo xtask android-pass` turns these into one verdict per row
// (`budgets.json`, `budgets.tsv`, the summary); `cargo xtask android-budgets --run <dir>` repeats
// that on a finished run. A `None` row has no budget or no pass step that measures it.
(
    tier: "android_reference",
    // The preset the frame, hitch and memory rows are read from.
    preset: "mobile_high",
    // Frame time p99: <= 16.6 ms at Mobile High. Read as the frame's work (ADR-4947): per frame the
    // larger of the CPU work and the GPU frame time (`play.hitch_report` `work.p99_ms`). A vsync-paced
    // interval on a 60 Hz panel is 16.67 ms whatever the frame costs, so it cannot be this row.
    frame_p99_ms: Some(16.6),
    // Presented frame interval p99 <= 1.05 x the refresh interval of the display the run measured
    // (`pacing.get` `refresh_hz`): the frames hold their display slot (ADR-4947).
    presented_p99_refresh_ratio: Some(1.05),
    // `06` § 4 sets only p99 for the reference tier.
    frame_p50_ms: None,
    // CPU main thread (sim + extract): <= 8 ms.
    cpu_p99_ms: Some(8.0),
    // Hitch rule: no frame over 50 ms after the first 10 s of play.
    longest_frame_ms: Some(50.0),
    // Memory (sample): <= 700 MB PSS.
    pss_mb: Some(700.0),
    // Cold start to the first interactive frame (shipping): <= 5 s.
    cold_start_ms: Some(5000.0),
    // Level load (sample level): <= 4 s in `06` § 4; no pass step measures it yet.
    level_load_ms: None,
    // Thermal run: the worst status stays under `severe` (3), where Android starts to throttle
    // hard and the governor steps the render scale down (ADR-1942).
    thermal_status: Some(2.0),
    // Thermal run: the frame p50 at the end stays within 25 % of the start (ADR-1942).
    thermal_p50_growth_pct: Some(25.0),
    // At most 5 % of the frames miss their display slot in the preset window (ADR-1942).
    pacing_late_pct: Some(5.0),
)
