BiomeDef(
    format_version: 1,
    name: "Pine forest",
    color: (0.15, 0.45, 0.2),
    priority: 20,
    layers: [
        (
            name: "canopy",
            rank: 30,
            source: Ground(spacing_m: 7.0, jitter: 0.9, noise: Some((scale_m: 70.0, octaves: 3, min: 0.3, max: 1.0))),
            channels: [(name: "steep", rule: Slope(min_deg: 24.0, max_deg: 90.0)), (name: "flat", rule: Rest)],
            entries: [
                (
                    name: "pine",
                    spawn: Mesh("trees/pine"),
                    weight: 3.0,
                    channels: ["flat"],
                    filters: [Slope(min_deg: 0.0, max_deg: 22.0, feather: 4.0), WaterDistance(min_m: 10.0, max_m: 2000.0, feather: 8.0)],
                    footprint: (core_m: Some(0.6), spread_m: Some(3.0)),
                    placement: (upright: 1.0, scale: Range(0.8, 1.25), yaw: Random, sink_m: 0.15),
                    render: (cast_shadows: true, draw_distance_m: 900.0, fade_m: 60.0, collision: None),
                    children: [(entry: "fern", count: (1, 3), radius_m: (1.5, 3.0), rate: 0.5, keep_clear_of_parent: Core)],
                ),
                (
                    name: "fern",
                    spawn: Mesh("plants/fern"),
                    weight: 0.0,
                    channels: [],
                    footprint: (core_m: Some(0.2), spread_m: Some(0.5)),
                    placement: (upright: 0.3, scale: Range(0.7, 1.1), yaw: Random),
                    render: (cast_shadows: false, draw_distance_m: 300.0, fade_m: 40.0, collision: None),
                ),
            ],
            max_child_depth: 1,
        ),
    ],
)
