ProcGraph(
    format_version: 1,
    description: "A road network: junctions, ribbons, markings, curbs from the ribbon edges, fences around the blocks the roads cut from a field, and rocks kept off the road",
    nodes: {
        1: (ty: "in.entities", settings: {tags: ["road"], as: "splines", within: "world"}, at: (0.0, 0.0)),
        2: (ty: "in.ground", settings: {}, at: (0.0, 160.0)),
        3: (ty: "terrain.flatten_road", settings: {}, at: (220.0, 0.0)),
        4: (ty: "road.junctions", settings: {}, at: (440.0, 0.0)),
        5: (ty: "road.ribbon", settings: {}, at: (660.0, 0.0)),
        6: (ty: "road.markings", settings: {material: "materials/paint.material.ron"}, at: (660.0, 160.0)),
        7: (ty: "spawn.mesh", settings: {entries: [(mesh: "props/curb_stone", weight: 1.0, draw_distance_m: 600.0)]}, at: (880.0, 0.0)),
        8: (ty: "in.entities", settings: {tags: ["field"], as: "splines", within: "world"}, at: (0.0, 320.0)),
        9: (ty: "polygon.from", settings: {mode: "ordered"}, at: (220.0, 320.0)),
        10: (ty: "polygon.cut", settings: {gap_m: 16.0}, at: (440.0, 320.0)),
        11: (ty: "polygon.to_spline", settings: {}, at: (660.0, 320.0)),
        12: (ty: "spline.modules", settings: {
            modules: {
                "post": (mesh: "props/fence_post", length_m: 0.2),
                "panel": (mesh: "props/fence_panel", length_m: 2.8, stretch: (0.85, 1.15)),
            },
            pattern: "post repeat(panel post)",
            fit: Stretch,
            forward_axis: X,
        }, at: (880.0, 320.0)),
        13: (ty: "spawn.mesh", settings: {
            pick: ByAttr(attr: "module"),
            entries: [(mesh: "props/fence_post", key: "post", draw_distance_m: 900.0), (mesh: "props/fence_panel", key: "panel", draw_distance_m: 900.0)],
        }, at: (1100.0, 320.0)),
        14: (ty: "in.self", settings: {}, at: (0.0, 500.0)),
        15: (ty: "sample.ground", settings: {spacing_m: 14.0, jitter: 0.9, align: "normal"}, at: (220.0, 500.0)),
        16: (ty: "road.exclusion", settings: {extra_m: 1.5}, at: (440.0, 660.0)),
        17: (ty: "region.subtract", settings: {}, at: (660.0, 500.0)),
        18: (ty: "spawn.mesh", settings: {entries: [(mesh: "props/rock", weight: 1.0, draw_distance_m: 900.0)]}, at: (880.0, 500.0)),
    },
    edges: [
        (from: (1, "out"), to: (3, "splines")),
        (from: (2, "out"), to: (3, "ground")),
        (from: (3, "out"), to: (4, "splines")),
        (from: (2, "out"), to: (4, "ground")),
        (from: (4, "out_splines"), to: (5, "splines")),
        (from: (2, "out"), to: (5, "ground")),
        (from: (4, "out_splines"), to: (6, "splines")),
        (from: (2, "out"), to: (6, "ground")),
        (from: (5, "out_edges"), to: (7, "in")),
        (from: (8, "out"), to: (9, "in")),
        (from: (9, "out"), to: (10, "in")),
        (from: (1, "out"), to: (10, "cutters")),
        (from: (10, "out"), to: (11, "in")),
        (from: (11, "out"), to: (12, "in")),
        (from: (12, "out"), to: (13, "in")),
        (from: (14, "out"), to: (15, "region")),
        (from: (1, "out"), to: (16, "splines")),
        (from: (15, "out"), to: (17, "in")),
        (from: (16, "out"), to: (17, "minus")),
        (from: (17, "out"), to: (18, "in")),
    ],
)
