// The Switchbacks stand-in scatter (`.scatter.ron` format v2, docs/formats/terrain.md § 2).
// Sizes are metres (meshes are ~1 m across at scale 1). Matched by eye to the UE v13 plates:
// many small red-brown stones, all darker than the dust, a few boulders, rubble on the slopes.
// Mesh paths name the DO27 rock set; lookdev binds procedural stand-ins to them
// (`regia_terrain::standin_library`, Mars palette).
ScatterSet(
    version: 2,
    seed: 2747,
    classes: [
        // Rare boulders: 0.6–2 m, most near the small end.
        ScatterClass(
            name: "boulders",
            meshes: [
                ScatterMeshRef(mesh: "props/rocks/mars_block_a.glb", weight: 2.0, min_scale: 0.6, max_scale: 2.0, scale_bias: 2.5),
                ScatterMeshRef(mesh: "props/rocks/mars_slab_a.glb", weight: 1.0, min_scale: 0.8, max_scale: 2.0, scale_bias: 2.0),
            ],
            cell_size: 14.0,
            density: 0.5,
            noise_scale: 120.0,
            noise_amount: 0.7,
            slope_max: 0.75,
            align_to_normal: 0.5,
            tilt_max: 0.45,
            tilt_jitter: 0.18,
            sink: 0.2,
            tint_jitter: 0.15,
            base_tint: (0.26, 0.14, 0.075),
            base_blend: 0.15,
            contact_ao: 0.55,
            fade_start: 260.0,
            fade_end: 340.0,
        ),
        // Stones: 15–60 cm.
        ScatterClass(
            name: "stones",
            meshes: [
                ScatterMeshRef(mesh: "props/rocks/mars_block_a.glb", weight: 1.0, min_scale: 0.15, max_scale: 0.6, scale_bias: 2.5),
                ScatterMeshRef(mesh: "props/rocks/mars_block_b.glb", weight: 1.0, min_scale: 0.15, max_scale: 0.6, scale_bias: 2.5),
                ScatterMeshRef(mesh: "props/rocks/mars_basalt_a.glb", weight: 0.5, min_scale: 0.15, max_scale: 0.5, scale_bias: 2.5),
            ],
            cell_size: 4.0,
            density: 0.9,
            noise_scale: 70.0,
            noise_amount: 0.75,
            slope_max: 0.8,
            align_to_normal: 0.7,
            tilt_max: 0.6,
            tilt_jitter: 0.25,
            sink: 0.25,
            tint_jitter: 0.18,
            base_tint: (0.26, 0.14, 0.075),
            base_blend: 0.15,
            contact_ao: 0.35,
            contact_radius: 1.4,
            fade_start: 110.0,
            fade_end: 150.0,
            shadow_max_lod: 2,
            shadow_distance: 80.0,
        ),
        // Pebbles: 5–30 cm, dense in patches, gone by 70 m.
        ScatterClass(
            name: "pebbles",
            meshes: [
                ScatterMeshRef(mesh: "props/rocks/mars_pebble_a.glb", weight: 2.0, min_scale: 0.05, max_scale: 0.3, scale_bias: 2.0),
                ScatterMeshRef(mesh: "props/rocks/mars_block_b.glb", weight: 1.0, min_scale: 0.05, max_scale: 0.25, scale_bias: 2.0),
                ScatterMeshRef(mesh: "props/rocks/mars_basalt_a.glb", weight: 1.0, min_scale: 0.05, max_scale: 0.2, scale_bias: 2.0),
            ],
            cell_size: 1.2,
            density: 0.9,
            noise_scale: 30.0,
            noise_amount: 0.6,
            slope_max: 0.7,
            align_to_normal: 0.9,
            tilt_max: 0.8,
            tilt_jitter: 0.3,
            sink: 0.3,
            tint_jitter: 0.2,
            contact_ao: 0.25,
            fade_start: 50.0,
            fade_end: 70.0,
            shadow_max_lod: 1,
            shadow_distance: 30.0,
        ),
        // Talus: rubble on the slopes under the cliffs.
        ScatterClass(
            name: "talus",
            meshes: [
                ScatterMeshRef(mesh: "props/rocks/mars_block_a.glb", weight: 1.0, min_scale: 0.15, max_scale: 1.0, scale_bias: 2.5),
                ScatterMeshRef(mesh: "props/rocks/mars_block_b.glb", weight: 1.0, min_scale: 0.15, max_scale: 0.8, scale_bias: 2.5),
                ScatterMeshRef(mesh: "props/rocks/mars_basalt_a.glb", weight: 0.5, min_scale: 0.15, max_scale: 0.6, scale_bias: 2.5),
            ],
            cell_size: 2.5,
            density: 1.2,
            slope_min: 0.3,
            slope_max: 1.0,
            align_to_normal: 0.8,
            tilt_max: 0.7,
            tilt_jitter: 0.25,
            sink: 0.25,
            tint_jitter: 0.15,
            base_tint: (0.26, 0.14, 0.075),
            base_blend: 0.15,
            contact_ao: 0.3,
            contact_radius: 1.35,
            fade_start: 160.0,
            fade_end: 220.0,
            shadow_max_lod: 2,
        ),
    ],
)
