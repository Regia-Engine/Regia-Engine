// Sample (.vfx.ron v7): motes that cling to a skinned mesh. The lab registers "lab/arm", a two
// bone strip; the host gives the instance its joint palette every frame and the motes spawn on
// the deformed surface (at most 24 per frame, sampled on the CPU and handed to the GPU emit stage
// like any spawn).
(
    version: 7,
    name: "sample_skinned_aura",
    system: (budget: 400),
    emitters: [
        (
            name: "motes",
            spawn: (mode: Rate(240.0), lifetime: (min: 0.5, max: 1.0)),
            init: (
                shape: SkinnedMesh(mesh: "lab/arm", max_per_frame: 24),
                velocity: (mode: Normal(speed: (min: 0.1, max: 0.3))),
                size: (min: 0.04, max: 0.08),
                color: [(t: 0.0, color: "#80c0ff")],
            ),
            update: (drag: 1.0, alpha_over_life: [(t: 0.0, v: 1.0), (t: 1.0, v: 0.0)]),
            render: (mode: Billboard, sprite: SoftDisc, blend: Additive, emissive: 2.0),
        ),
    ],
)
