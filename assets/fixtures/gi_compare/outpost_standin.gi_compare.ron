// A synthetic outpost on rolling ground: the look-review stand-in for a large DO27-style map
// (no DO27 data). A 256 m terrain in a shallow valley, a hab (closed, one door), a hangar (one
// wide door), a tower, containers and rocks. The hab and the hangar are interiors: their bricks
// carry the INTERIOR flag, and their doors face the sun, so their light comes in through the
// door only. Generated by the look-pack lane's script (ADR-1326); floors sit at the highest
// ground under each building, so the terrain never shows through. Read by `cargo xtask gi-compare`.
(
    format_version: 1,
    name: "outpost_standin",
    purpose: "large outdoor with two interiors (stand-in for a DO27 map, ADR-1326)",
    sun: Some((toward: (0.45, 0.55, 0.7), color: (1.0, 0.95, 0.88), lux: 100000.0)),
    sky_lux: 15000.0,
    materials: [
        (name: "ground", albedo: (0.26, 0.23, 0.19)),
        (name: "hab", albedo: (0.62, 0.62, 0.6)),
        (name: "hangar", albedo: (0.5, 0.52, 0.55)),
        (name: "deck", albedo: (0.35, 0.33, 0.3)),
        (name: "accent", albedo: (0.7, 0.32, 0.12)),
        (name: "vehicle", albedo: (0.22, 0.3, 0.2), roughness: 0.6),
        (name: "rock", albedo: (0.4, 0.38, 0.35)),
    ],
    terrain: Some((
        size: (256.0, 256.0),
        spacing: 2.0,
        height: 14.0,
        material: "ground",
        waves: [
            (amplitude: 8, wavelength: (220.0, 0.0), phase: 3.14159),
            (amplitude: 6, wavelength: (0.0, 180.0), phase: 3.14159),
            (amplitude: 0.3, wavelength: (13.0, 17.0), phase: 0.00000),
        ],
    )),
    shapes: [
        (name: "hab_floor", kind: Box(half: (6.300, 1.227, 4.300)), material: "deck", at: (-14.000, 0.723, -6.000)),
        (name: "hab_roof", kind: Box(half: (6.300, 0.150, 4.300)), material: "hab", at: (-14.000, 5.600, -6.000)),
        (name: "hab_west", kind: Box(half: (0.150, 2.977, 4.300)), material: "hab", at: (-20.150, 2.473, -6.000)),
        (name: "hab_east", kind: Box(half: (0.150, 2.977, 4.300)), material: "hab", at: (-7.850, 2.473, -6.000)),
        (name: "hab_north", kind: Box(half: (6.000, 2.977, 0.150)), material: "hab", at: (-14.000, 2.473, -10.150)),
        (name: "hab_south_left", kind: Box(half: (2.600, 2.977, 0.150)), material: "hab", at: (-17.400, 2.473, -1.850)),
        (name: "hab_south_right", kind: Box(half: (2.600, 2.977, 0.150)), material: "hab", at: (-10.600, 2.473, -1.850)),
        (name: "hab_lintel", kind: Box(half: (0.800, 0.550, 0.150)), material: "hab", at: (-14.000, 4.900, -1.850)),
        (name: "hangar_floor", kind: Box(half: (10.300, 1.683, 8.300)), material: "deck", at: (12.000, 0.977, -10.000)),
        (name: "hangar_roof", kind: Box(half: (10.300, 0.150, 8.300)), material: "hangar", at: (12.000, 10.810, -10.000)),
        (name: "hangar_west", kind: Box(half: (0.150, 5.683, 8.300)), material: "hangar", at: (1.850, 4.977, -10.000)),
        (name: "hangar_east", kind: Box(half: (0.150, 5.683, 8.300)), material: "hangar", at: (22.150, 4.977, -10.000)),
        (name: "hangar_north", kind: Box(half: (10.000, 5.683, 0.150)), material: "hangar", at: (12.000, 4.977, -18.150)),
        (name: "hangar_south_left", kind: Box(half: (2.000, 5.683, 0.150)), material: "hangar", at: (4.000, 4.977, -1.850)),
        (name: "hangar_south_right", kind: Box(half: (2.000, 5.683, 0.150)), material: "hangar", at: (20.000, 4.977, -1.850)),
        (name: "hangar_lintel", kind: Box(half: (6.000, 0.750, 0.150)), material: "hangar", at: (12.000, 9.910, -1.850)),
        (name: "hab_console", kind: Box(half: (0.800, 0.500, 0.600)), material: "accent", at: (-18.400, 2.450, -9.000)),
        (name: "hab_bunk", kind: Box(half: (1.300, 0.350, 1.000)), material: "deck", at: (-9.700, 2.300, -8.500)),
        (name: "hangar_vehicle", kind: Box(half: (3.500, 1.300, 2.500)), material: "vehicle", at: (11.500, 3.960, -11.500)),
        (name: "tower", kind: Box(half: (2.000, 10.776, 2.000)), material: "hab", at: (-2.000, 10.416, 14.000)),
        (name: "container_0", kind: Box(half: (3.000, 1.856, 1.200)), material: "accent", at: (-4.000, 1.322, 4.000), yaw_deg: 10.0),
        (name: "container_1", kind: Box(half: (3.000, 1.984, 1.200)), material: "vehicle", at: (4.000, 1.378, 7.000), yaw_deg: -20.0),
        (name: "container_2", kind: Box(half: (3.000, 2.249, 1.200)), material: "accent", at: (-26.000, 3.309, 8.000), yaw_deg: 35.0),
        (name: "rock_0", kind: Ellipsoid(radii: (4, 2.5, 3.5)), material: "rock", at: (30.00, 6.35, -30.00), yaw_deg: 30.0),
        (name: "rock_1", kind: Ellipsoid(radii: (6, 3, 5)), material: "rock", at: (-40.00, 7.37, 20.00), yaw_deg: -20.0),
        (name: "rock_2", kind: Ellipsoid(radii: (3, 2, 4)), material: "rock", at: (-35.00, 8.32, -35.00), yaw_deg: 70.0),
        (name: "rock_3", kind: Ellipsoid(radii: (2.5, 1.6, 2)), material: "rock", at: (25.00, 4.42, 25.00), yaw_deg: 10.0),
        (name: "rock_4", kind: Ellipsoid(radii: (9, 5, 7)), material: "rock", at: (55.00, 10.24, 10.00), yaw_deg: 0.0),
    ],
    layout: (
        terrain: Some((spacing: (8.0, 8.0), levels: [0.5, 2.0, 5.0, 12.0, 30.0])),
        bricks: [
            // The built-up area, outdoors.
            (min: (-30.0, 0.0, -25.0), max: (30.0, 14.0, 25.0), spacing: 2.0),
            // The hab's air and the hangar's air (interiors). Each lattice lies on its interior's
            // box (the walls' inner faces), as `regia bake-gi --from-scene` places it (ADR-1364).
            (min: (-20.0, 1.95, -10.0), max: (-8.0, 5.45, -2.0), spacing: 0.5),
            (min: (2.0, 2.66, -18.0), max: (22.0, 10.66, -2.0), spacing: 1.0),
        ],
        interiors: [
            (min: (-20.0, 1.95, -10.0), max: (-8.0, 5.45, -2.0)),
            (min: (2.0, 2.66, -18.0), max: (22.0, 10.66, -2.0)),
        ],
        moment_resolution: 8,
        max_distance: 48.0,
    ),
    // regia bake-gi's defaults (ProbeTraceSettings::default): 256 rays x 16 samples, 8 bounces.
    bake: (rays_per_probe: 256, samples: 16, max_bounces: 8, seed: 1),
)
