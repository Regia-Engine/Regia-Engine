<script>
/* PiercingXX lockup for the mdBook menu bar. The SVG matches book/theme/logomark.svg. */
(function () {
  var MARK = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 108 108" class="mark" aria-hidden="true" focusable="false"><rect width="108" height="108" rx="22" fill="#000000"/><path d="M40,26 L68,54 M40,54 L68,26" fill="none" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round"/><path d="M40,52 L68,80 M40,80 L68,52" fill="none" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round"/><path d="M38,88 L70,88" fill="none" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round"/></svg>';
  function mount() {
    var title = document.querySelector("h1.menu-title");
    if (!title || title.querySelector(".pxx-mark")) return;
    var slot = document.createElement("span");
    slot.className = "pxx-mark";
    slot.setAttribute("aria-hidden", "true");
    slot.innerHTML = MARK;
    title.prepend(slot);
    title.classList.add("pxx-lockup");
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", mount);
  else mount();
})();
</script>
