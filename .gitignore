/target
# Per-crate test output (golden-failure PNGs written next to a crate's manifest)
/crates/*/target/
/samples/*/target/
**/.regia/
.regia/test-assets/
*.keystore

# Claude Code local state (agent worktrees)
/.claude/*
!/.claude/skills/
# Generated Gradle projects, cooked paks and packaged builds (regia cook/package)
**/build/
**/dist/
# ...except the public-export overlay (spec 125 § 4, ADR-10135): the root dist/ stays ignored, its public-root/ is tracked.
!/dist/
/dist/*
!/dist/public-root/
!/dist/public-root/dist/
# The user skills' sources (the export writes them to `.claude/skills/`); a `.claude/` folder in the overlay is
# never tracked: it would load as live skills in every session opened on this repository (ADR-10230).
!/dist/public-skills/
/dist/public-root/.claude/
# In the public snapshot the overlay's `dist/mcp/` sits at the root (ADR-10230).
!/dist/mcp/

# glTF model cache for golden tests
crates/regia_test_utils/gltf-cache/
# rename-keep-begin: paths from before the rename to Regia Engine (ADR-1388) stay ignored for one
# release, so old caches in a checkout are never picked up as new files.
**/.ferrite/
crates/ferrite_test_utils/gltf-cache/
# rename-keep-end
LANE-REPORT.md
