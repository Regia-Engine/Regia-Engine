// The CPU budget registry (format `perf-budgets` v1, docs/formats/perf-budgets-ron.md, ADR-2704).
// One entry per budget a spec states, or per number worth a baseline (`Unbudgeted`). `cargo xtask perf-budgets` runs it.
// Where a spec names no statistic the entry compares p50 or criterion's estimate. Commands that share a build stay
// next to each other: a change of `-p` list or features recompiles shared crates.
(
    format_version: 1,
    entries: [
        (
            name: "frame_200_empty_systems",
            spec: "spec 10 § 4",
            package: "regia_app",
            command: "cargo bench -p regia_app --bench schedule -- --noplot",
            metric: "^frame_200_empty_systems\\s+time:\\s+\\[[^\\]]*\\]",
            stat: CriterionEstimate,
            budget: Ms(0.15),
            note: "desktop reference",
        ),
        (
            name: "schedule_tick_template_shape",
            spec: "ADR-2704",
            package: "regia_app",
            command: "cargo test -p regia_app --release --test perf_micro_schedule -- --ignored --nocapture --test-threads=1 perf_micro",
            metric: "perf-micro schedule_tick_template_shape: .*$",
            stat: P50,
            budget: Unbudgeted,
            note: "the third_person template's entities and game systems without the plugins' systems; not the docs/06 § 4 main-thread budget",
        ),
        (
            name: "schedule_tick_template_shape_allocs",
            spec: "ADR-2704",
            package: "regia_app",
            command: "cargo test -p regia_app --release --test perf_micro_schedule -- --ignored --nocapture --test-threads=1 perf_count",
            metric: "perf-count schedule_tick_template_shape_allocs: .*$",
            stat: AllocsPerOp,
            budget: Unbudgeted,
            note: "main thread only",
        ),
        (
            name: "schedule_tick_template_shape_bytes",
