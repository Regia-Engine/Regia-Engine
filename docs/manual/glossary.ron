// Glossary source for `cargo xtask manual` (ADR-10418).
// Terms are rendered to book/reference/glossary.md in alphabetical order.
// `page` is relative to book/. `see_also` names another term in this file.
(
    terms: [
        (
            term: "ECS world",
            definition: "The data of a running game lives in one world: entities, the components on them, the systems that read and write those components, and singleton resources.",
            see_also: ["Entity", "Component", "System", "Schedule"],
            page: "fundamentals/ecs.md",
        ),
        (
            term: "Entity",
            definition: "An id with no data of its own. What an entity is comes from the components attached to it.",
            see_also: ["Component", "ECS world"],
            page: "fundamentals/ecs.md#the-ecs-entities-components-systems",
        ),
        (
            term: "Component",
            definition: "A plain Rust value attached to an entity, such as a transform or a health value. A marker component carries no fields and exists so a system can filter on it.",
            see_also: ["Entity", "ECS world"],
            page: "fundamentals/ecs.md#components",
        ),
        (
            term: "System",
            definition: "A Rust function the frame runs to read and write components and resources. Which systems run, and in what order, is the schedule they were added to.",
            see_also: ["Schedule", "ECS world"],
            page: "fundamentals/ecs.md#systems-and-queries",
        ),
        (
            term: "Resource",
            definition: "A singleton value stored in the world, such as the clock or the asset server. There is one of each resource type.",
            see_also: ["ECS world", "Asset server"],
            page: "fundamentals/ecs.md#resources",
        ),
        (
            term: "Schedule",
            definition: "A named stage of the frame that runs a set of systems. The frame runs Startup, First, PreUpdate, FixedUpdate, Update, PostUpdate, Extract, Render and Last, and StateTransition around them.",
            see_also: ["FixedUpdate", "Update", "Frame"],
            page: "fundamentals/app-and-plugins.md#the-frame",
        ),
        (
            term: "FixedUpdate",
            definition: "The schedule for simulation that must not depend on frame rate. It runs at FixedTime::hz (default 60), as many times as the accumulated time requires, and at most max_substeps times in one frame (default 5, hard cap 64).",
            see_also: ["Schedule", "Update"],
            page: "fundamentals/app-and-plugins.md#time-and-the-fixed-timestep",
        ),
        (
            term: "Update",
            definition: "The schedule that runs most gameplay once per frame, after FixedUpdate and before PostUpdate.",
            see_also: ["Schedule", "FixedUpdate"],
            page: "fundamentals/app-and-plugins.md#the-frame",
        ),
        (
            term: "Frame",
            definition: "One pass of the app, from the clocks through the render graph and present. A paused clock still runs Update. FixedUpdate runs only when a fixed step is due.",
            see_also: ["Schedule", "FixedUpdate"],
            page: "fundamentals/app-and-plugins.md#the-frame",
        ),
        (
            term: "Plugin",
            definition: "A type that implements Plugin. Its build method adds systems, resources, messages and other plugins to the app.",
            see_also: ["Schedule", "ECS world"],
            page: "fundamentals/app-and-plugins.md#plugins",
        ),
        (
            term: "Level",
            definition: "A scene file the editor saves and the game loads: entities with stable ids, names and reflected components. The loader migrates an older scene version in memory.",
            see_also: ["Scene", "Prefab"],
            page: "user-guide/scenes.md#levels",
        ),
        (
            term: "Prefab",
            definition: "An entity subtree saved for reuse. Spawning an instance applies overrides on top of the template and does not edit the template.",
            see_also: ["Level", "Scene"],
            page: "user-guide/scenes.md#prefabs",
        ),
        (
            term: "Scene",
            definition: "The text files that store levels and prefabs. Re-saving an unchanged level writes the same bytes.",
            see_also: ["Level", "Prefab"],
            page: "user-guide/scenes.md",
        ),
        (
            term: "Cook",
            definition: "The step that turns source assets into the compact data the runtime loads. It is incremental: an output is rebuilt only when its source, import settings or importer version changed.",
            see_also: ["Package", "Asset id", "Cooked mesh"],
            page: "fundamentals/assets.md#what-the-cook-does",
        ),
        (
            term: "Package",
            definition: "A shipped build. The package command cooks when the archives are stale and writes the cooked data beside the executable.",
            see_also: ["Pak", "Cook"],
            page: "user-guide/packaging.md",
        ),
        (
            term: "Asset id",
            definition: "The stable id stored in a source asset's .meta sidecar. It does not change when the file moves, and levels refer to assets by this id.",
            see_also: ["Cook", "Asset server"],
            page: "fundamentals/assets.md#meta-sidecars-and-asset-ids",
        ),
        (
            term: "Pak",
            definition: "A packed archive of cooked assets (.fpak). A packaged game reads the same cooked data from these archives that a development game reads from the cook cache.",
            see_also: ["Package", "Asset server"],
            page: "fundamentals/assets.md#packaging",
        ),
        (
            term: "Asset server",
            definition: "The AssetServer resource loads cooked assets by project path or id, from mounted pak archives first and then from the cook cache.",
            see_also: ["Cook", "Pak", "Asset id"],
            page: "fundamentals/assets.md#loading-cooked-assets",
        ),
        (
            term: "VFS",
            definition: "The virtual file system every engine file access goes through. Mounts include assets, config, user, cache and logs. Only the user and cache mounts are writable.",
            see_also: ["Package", "Asset server"],
            page: "fundamentals/assets.md#where-files-live-the-vfs",
        ),
        (
            term: "Hot reload",
            definition: "A dev build that watches the cook cache reloads a cooked file in place when the cook rewrites it. The next frame uses the new data.",
            see_also: ["Cook", "Play in editor"],
            page: "fundamentals/assets.md#hot-reload-of-assets",
        ),
        (
            term: "Cooked mesh",
            definition: "The mesh the cook writes for a glTF primitive, including its LODs. With meshlets enabled, the cook also writes a cluster file that indexes that mesh's vertices.",
            see_also: ["Cook", "Meshlet"],
            page: "agents/visbuffer.md#cooking-meshlets",
        ),
        (
            term: "Meshlet",
            definition: "A small cluster of triangles built over LOD 0 of a cooked mesh. The visibility-buffer path draws these clusters.",
            see_also: ["Visibility buffer", "Cooked mesh"],
            page: "agents/visbuffer.md#cooking-meshlets",
        ),
        (
            term: "Visibility buffer",
            definition: "A render path that records which primitive covers each pixel and shades afterwards. A glTF cooks meshlet clusters when its .meta sets meshlets.",
            see_also: ["Meshlet", "Render profile"],
            page: "agents/visbuffer.md",
        ),
        (
            term: "DDGI",
            definition: "The dynamic global-illumination field: camera-relative cascades of irradiance probes that trace the terrain heightfield and per-mesh distance fields, with Chebyshev visibility so light does not pass through closed walls.",
            see_also: ["Probe volume", "Quality tier"],
            page: "agents/dynamic-gi.md",
        ),
        (
            term: "Probe volume",
            definition: "A grid of irradiance probes (a GiField) that store the light arriving from every direction. Inside the grid the probes replace the sky term.",
            see_also: ["DDGI", "Lightmap"],
            page: "systems/lighting.md#indirect-light",
        ),
        (
            term: "Lightmap",
            definition: "Baked irradiance stored per texel for the static meshes of a map. The level names the lightmap, or the renderer installs it, and the receivers shade with it.",
            see_also: ["Probe volume", "Cook"],
            page: "agents/lightmaps.md",
        ),
        (
            term: "Reflection probe",
            definition: "A captured environment the renderer uses when a screen-space reflection misses. The renderer picks a short list of probes by distance from the camera.",
            see_also: ["Lightmap", "Probe volume"],
            page: "systems/lighting.md#reflections",
        ),
        (
            term: "Render profile",
            definition: "A named bundle of quality settings, such as MobileLow, DesktopHigh, DesktopUltra or Deck. A game installs one through RenderSettings.",
            see_also: ["Quality tier", "Render graph"],
            page: "user-guide/rendering.md#render-profiles",
        ),
        (
            term: "Quality tier",
            definition: "The graphics budget automatic quality detection picks for a machine, from VeryLow through Ultra, plus Deck and the mobile presets. Each tier selects a render profile and a frame-rate target.",
            see_also: ["Render profile", "DDGI"],
            page: "user-guide/auto-quality.md#tiers",
        ),
        (
            term: "Render graph",
            definition: "The frame's passes in recording order, with the resources each pass reads and writes. A game adds a pass at a named slot, and the frame still submits once.",
            see_also: ["Render profile", "Frame"],
            page: "agents/render-graph.md",
        ),
        (
            term: "Material",
            definition: "The surface description a mesh shades with. A source material cooks into the runtime material and references cooked textures.",
            see_also: ["Cook", "Cooked mesh"],
            page: "user-guide/materials.md",
        ),
        (
            term: "Anim graph",
            definition: "A graph that blends animation clips and drives a skeleton. The cook writes the runtime graph from the source file.",
            see_also: ["Character"],
            page: "user-guide/animation.md#anim-graphs",
        ),
        (
            term: "Character",
            definition: "The body a controller drives. A player controller is the human; an AI controller drives a bot. Gameplay code spawns the character with a movement component.",
            see_also: ["Prediction", "Anim graph"],
            page: "user-guide/gameplay.md",
        ),
        (
            term: "Input",
            definition: "The actions a player produces. The frame turns platform events into input state before gameplay systems read it.",
            see_also: ["Character", "FixedUpdate"],
            page: "user-guide/input.md",
        ),
        (
            term: "Save game",
            definition: "A file under the user mount that stores a player's progress. The gameplay layer reads and writes it through the virtual file system.",
            see_also: ["Level", "Scene"],
            page: "user-guide/gameplay.md",
        ),
        (
            term: "Lobby hub",
            definition: "A self-hosted process that gives games lobbies, a directory, presence and invites. Clients talk to it with the hub lobby backend.",
            see_also: ["Relay", "Dedicated server"],
            page: "agents/net-lobby-hub.md",
        ),
        (
            term: "Relay",
            definition: "A process that forwards datagrams between a host and clients that cannot reach each other directly. A dedicated server can publish a relay and a join code.",
            see_also: ["Join code", "Lobby hub"],
            page: "agents/net-relay.md",
        ),
        (
            term: "Join code",
            definition: "A short code the relay gives a host. Another client joins with that code instead of with an address.",
            see_also: ["Relay"],
            page: "agents/net-relay.md#join-by-code-the-clients-codes",
        ),
        (
            term: "Lockstep",
            definition: "A simulation in which every peer runs the same inputs through the same math and gets the same state. Lockstep code stays on integer and deterministic operations.",
            see_also: ["Rollback", "FixedUpdate"],
            page: "agents/lockstep-math.md",
        ),
        (
            term: "Rollback",
            definition: "A lockstep mode that steps ahead with predicted inputs and replays from the first tick whose real inputs differ when the frame arrives. Only confirmed ticks are hashed.",
            see_also: ["Lockstep", "Prediction"],
            page: "agents/net-lockstep.md#rollback-lockstep",
        ),
        (
            term: "Net wire version",
            definition: "The number REGIA_NET_WIRE_VERSION (6) stamped on a connection. A peer on another wire, another protocol hash or another content manifest is refused.",
            see_also: ["Client", "Dedicated server"],
            page: "user-guide/networking.md#when-versions-or-content-differ",
        ),
        (
            term: "Agent protocol",
            definition: "The JSON protocol a dev build serves so a tool can inspect and drive a running app. The app writes an endpoint file when it starts.",
            see_also: ["Play in editor"],
            page: "agents/protocol.md",
        ),
        (
            term: "Play in editor",
            definition: "The editor copies the edit world into a separate play world and runs it. Play does not write back to the edit world.",
            see_also: ["Agent protocol", "Hot reload"],
            page: "start/editor-tour.md#play-in-editor",
        ),
        (
            term: "Listen server",
            definition: "A net mode that hosts the session and also has local players. The same process simulates and renders.",
            see_also: ["Dedicated server", "Client", "Net mode"],
            page: "user-guide/networking.md#modes-transports-and-finding-a-game",
        ),
        (
            term: "Dedicated server",
            definition: "A net mode that hosts with no local players, no rendering and no audio. Packaging a server build produces that process.",
            see_also: ["Listen server", "Client", "Package"],
            page: "user-guide/networking.md#modes-transports-and-finding-a-game",
        ),
        (
            term: "Client",
            definition: "A net mode that joins a server. It sends inputs and receives replicated state.",
            see_also: ["Dedicated server", "Prediction"],
            page: "user-guide/networking.md#client",
        ),
        (
            term: "Net mode",
            definition: "Which role a process runs: Offline, ListenServer, DedicatedServer or Client. Offline is the default.",
            see_also: ["Client", "Listen server", "Dedicated server"],
            page: "user-guide/networking.md#modes-transports-and-finding-a-game",
        ),
        (
            term: "Prediction",
            definition: "The client simulates its own character ahead of the server and corrects when the server's state arrives.",
            see_also: ["Rollback", "Client"],
            page: "user-guide/networking.md#predicting-your-own-character-spec-73",
        ),
        (
            term: "Content format",
            definition: "A frozen on-disk shape for game content, with a version field. A loader rejects a newer version and runs migrators for an older one.",
            see_also: ["Migrator", "Cook"],
            page: "changing-a-content-format.md",
        ),
        (
            term: "Migrator",
            definition: "A registered step that reads one older content-format version and writes the next. A version bump ships with a migrator, and upgrade-project can rewrite the files on disk.",
            see_also: ["Content format"],
            page: "changing-a-content-format.md",
        ),
    ],
)
